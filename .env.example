# Copy this file to `.env` (gitignored, never commit it) and adjust for
# your local environment. Values below match docker-compose.yml's default
# local development Postgres service exactly -- they are placeholder
# development values, not production credentials, and are safe to keep
# as-is for local development. DATABASE_URL has no default in code
# (school_timetable.config.Settings): this file (or an equivalent
# environment variable) must be present for the app or Alembic to start.

# Read by school_timetable.config.Settings (app + Alembic).
DATABASE_URL=postgresql+psycopg://school_timetable:school_timetable@localhost:5432/school_timetable

# Read directly by tests_web/ (never by the app itself). Points at the
# separate database docker/init-test-db.sh creates alongside the main
# development database in the same local Postgres container.
TEST_DATABASE_URL=postgresql+psycopg://school_timetable:school_timetable@localhost:5432/school_timetable_test

# Optional: read by docker-compose.yml (via its own .env lookup, not by
# the app) to override the local Postgres container's user/password/db
# name/port/bind address. Uncomment and change if you need non-default
# values; the compose file falls back to the same placeholders above
# when unset. POSTGRES_BIND_HOST defaults to 127.0.0.1 (loopback-only --
# the container is not reachable from other hosts on the network unless
# you deliberately override this); only change it if you specifically
# need the database reachable from outside this machine.
# POSTGRES_USER=school_timetable
# POSTGRES_PASSWORD=school_timetable
# POSTGRES_DB=school_timetable
# POSTGRES_PORT=5432
# POSTGRES_BIND_HOST=127.0.0.1
