# Copy this file to .env.local (gitignored) and fill in real pilot values.
# See src/config/appConfig.ts -- this is the ONE place these two values
# are read/interpreted for the whole frontend (Phase 3B first-view
# Decision #32, Owner Decision 6: school/year are pilot-fixed through a
# single replaceable configuration point, never scattered literal IDs).

# Natural school ID, matching the backend's School.id (e.g. the pilot
# school seeded in the database).
VITE_SCHOOL_ID=

# Natural academic year ID, matching the backend's AcademicYear.id.
VITE_ACADEMIC_YEAR_ID=
